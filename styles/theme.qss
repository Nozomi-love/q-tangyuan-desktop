/* Illustrated paper, walnut outlines and soft leaf-green highlights. */
QWidget { font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif; font-size: 13px; color: #6c523d; }
QMainWindow#dashboard, QWidget#dashboardRoot { background: #eee0c8; }
QScrollArea, QScrollArea > QWidget > QWidget, QWidget#bookPage { background: transparent; border: none; }
QFrame#floatingHud { background: transparent; border: none; }
QFrame#hudProfile { background: rgba(255, 248, 230, 226); border: 1px solid #b29472; border-radius: 16px; }
QFrame#coinCapsule { background: rgba(249, 229, 183, 238); border: 1px solid #b39767; border-radius: 17px; min-height: 29px; }
QLabel { background: transparent; border: none; }
QLabel#petName { color: #6a4935; font-size: 16px; font-weight: 700; }
QLabel#titlePlaque { color: #9e7954; font-size: 11px; }
QLabel#levelBadge { background: #c5a476; color: #fff9e7; border: 1px solid #a3835e; border-radius: 9px; font-size: 12px; font-weight: 600; }
QLabel#coinAmount { font-size: 17px; font-weight: 700; color: #956f3b; min-width: 34px; }
QLabel#buffBadge { color: #9d7257; font-size: 11px; padding: 2px; }
QFrame#inventoryBook { background: #f9edd6; border: 2px solid #805f45; border-radius: 15px; }
QLabel#bookTitle { font-size: 18px; font-weight: 700; color: #765339; padding: 2px; }
QFrame#gameCard { background: #fff6e2; border: 1px solid #b99a76; border-bottom: 2px solid #b99a76; border-radius: 13px; }
QLabel#itemName { font-size: 14px; font-weight: 700; color: #79543a; qproperty-alignment: AlignCenter; }
QLabel#itemTag { color: #9b774f; font-size: 12px; qproperty-alignment: AlignCenter; }
QLabel#sectionTitle { font-size: 16px; color: #82603f; font-weight: 700; padding: 5px 0; }
QLabel#muted { color: #9c846b; font-size: 12px; }
QFrame#navDivider { background: #dcc5a4; border: none; }
QFrame#feedingShelf { background: #e5cdac; border: 1px solid #a7805a; border-bottom: 2px solid #a98258; border-radius: 11px; }
QPushButton { background: #efd9b5; border: 1px solid #bc996c; border-bottom: 3px solid #b48f62; border-radius: 10px; padding: 7px 9px; min-height: 18px; color: #6e4f35; }
QPushButton:hover { background: #f6e4c2; border-color: #aa875c; }
QPushButton:pressed { background: #dfc299; border-bottom: 1px solid #a58258; }
QPushButton:checked, QPushButton[primary="true"] { background: #d5deb6; border-color: #9aa679; border-bottom-color: #879568; color: #52613b; }
QPushButton:disabled { background: #e8ddc9; color: #b0a18a; border-color: #d2c2a8; }
QPushButton#gameToggle:checked { background: #d6e0bd; border: 2px solid #96a775; color: #56683e; }
QTabWidget::pane { border: none; background: transparent; }
QTabBar { background: transparent; }
QTabBar::tab { background: #e9d6b6; color: #94744e; border: 1px solid #c7aa80; border-radius: 9px; margin: 0 3px 4px 0; padding: 7px 6px; min-width: 48px; }
QTabBar::tab:selected { background: #cdd8b0; color: #5d6d45; border-color: #99a477; font-weight: 600; }
QTabBar::tab:hover { background: #e1d2aa; }
QProgressBar { background: #dfd0b7; border: 1px solid #c0a580; border-radius: 7px; min-height: 18px; max-height: 22px; text-align: center; color: #6f573c; font-size: 11px; }
QProgressBar::chunk { background: #dcaeab; border-radius: 6px; }
QProgressBar#hungerBar::chunk { background: #b8ca8d; }
QProgressBar#affectionBar::chunk { background: #ddb3aa; }
QScrollBar:vertical { background: #eee0c8; width: 7px; border-radius: 3px; margin: 3px 0; }
QScrollBar::handle:vertical { background: #bfa27b; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: #eee0c8; height: 7px; border-radius: 3px; }
QScrollBar::handle:horizontal { background: #bfa27b; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QSlider::groove:horizontal { height: 8px; background: #dfc9aa; border: 1px solid #c3a37b; border-radius: 4px; }
QSlider::sub-page:horizontal { background: #b6c495; border-radius: 4px; }
QSlider::handle:horizontal { width: 19px; margin: -7px 0; background: #f8edcf; border: 2px solid #a38761; border-radius: 10px; }
QLabel#disclaimer { color: #967c60; padding: 10px; background: #ede0c9; border-radius: 10px; font-size: 11px; }
QLabel#milestone { color: #a28b70; }
QLabel#milestone[unlocked="true"] { color: #64764b; }
QLineEdit { background: #fff5dc; padding: 9px; border: 2px solid #bd9c71; border-radius: 8px; selection-background-color: #d8dfb9; }
QMenu { background: #fff1d8; border: 2px solid #b59870; border-radius: 12px; padding: 7px; }
QMenu::item { padding: 8px 20px; border-radius: 7px; }
QMenu::item:selected { background: #dce2c4; }
QMenu::item:disabled { color: #ad987e; }
QMenu::separator { height: 1px; background: #d8c2a1; margin: 5px; }
QToolTip { background: #fff4da; color: #796044; border: 1px solid #c6ac83; padding: 6px; }

/* Keyboard focus keeps the painted game outline; suppress native dotted rectangles. */
QPushButton, QTabBar::tab { outline: none; }
QPushButton:focus, QSlider:focus { border-color: #8e9b65; }
QFrame#floatingHud QPushButton { padding: 1px; min-height: 14px; border-radius: 8px; }
QFrame#floatingHud QProgressBar { min-height: 15px; max-height: 16px; font-size: 10px; }

/* Compact book cards retain large illustrations and clear transaction buttons. */
QFrame#gameCard QPushButton { padding: 4px 6px; min-height: 19px; border-radius: 8px; font-size: 12px; }
QFrame#floatingHud QLabel#petName { font-size: 14px; }
QFrame#floatingHud QLabel#titlePlaque { font-size: 10px; }
QFrame#floatingHud QLabel#buffBadge { font-size: 10px; }
QFrame#floatingHud QLabel#coinAmount { font-size: 15px; min-width: 0; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #a98b64; }

/* A pressed sound capsule always means muted; keyboard controls remain available. */
QPushButton#muteControl { background: #f5e4c7; border: 1px solid #b89b73; }
QPushButton#muteControl:checked { background: #dbc6cf; border: 2px solid #aa7c8d; }

/* Painted dock buttons reserve their full content height after QSS polish. */
QPushButton#dockNavigation { min-height: 62px; max-height: 62px; padding: 0; margin: 0; border: none; background: transparent; }

/* Release wardrobe preview and the next shared growth goal. */
QFrame#skinPreviewCard { background: #f3e7cc; border: 1px solid #bc9e78; border-radius: 12px; padding: 4px; }
QLabel#nextMilestone { color: #6e7e4d; background: #e5e9cf; border: 1px solid #b5c096; border-radius: 9px; padding: 9px; font-weight: 600; }

/* Inventory categories and the dressing subcategories keep a distinct hierarchy. */
QTabWidget#bagTabs > QTabBar::tab, QTabWidget#progressTabs > QTabBar::tab { padding: 8px 5px; }
QTabWidget#dressTabs > QTabBar::tab { background: #f1e5ce; border-color: #d4bc99; padding: 6px 5px; }
QTabWidget#dressTabs > QTabBar::tab:selected { background: #e1e7cb; color: #5d6d45; border-color: #9ca87e; }
